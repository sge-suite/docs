erDiagram
    USERS ||--|| USER_PERSONAL_DATA : user_id
    USERS ||--o{ SUPERVISOR_QUALIFICATIONS : user_id
    USERS ||--o{ AFFILIATIONS : user_id
    CITIES ||--o{ ADDRESSES : city_id
    ADDRESSES ||--o{ USER_PERSONAL_DATA : address_id
    ADDRESSES ||--o{ CAMPUSES : address_id
    CAMPUSES ||--o{ AFFILIATIONS : campus_id

    USERS {
        bigint id PK
        varchar name
        varchar email UK
        varchar cpf UK
        varchar password
        timestamp created_at
    }
    USER_PERSONAL_DATA {
        bigint id PK
        bigint user_id FK
        varchar rg
        varchar phone
        varchar job_role
        bigint address_id FK
    }
    SUPERVISOR_QUALIFICATIONS {
        bigint id PK
        bigint user_id FK
        varchar type
        varchar training_course
        varchar education_level
        varchar experience_area
        varchar experience_time
    }
    ADDRESSES {
        bigint id PK
        bigint city_id FK
        varchar street
        varchar number
        varchar neighborhood
        char zip_code
    }
    CITIES {
        bigint id PK
        char ibge_code UK
        varchar name
        char state
    }
    CAMPUSES {
        bigint id PK
        varchar name
        varchar internship_office_email
        varchar legal_representative_name
        varchar legal_representative_position
        bigint address_id FK
        timestamp deactivated_at
    }
    AFFILIATIONS {
        bigint id PK
        bigint user_id FK
        bigint campus_id FK
        bigint course_id FK
        varchar type
        timestamp deactivated_at
    }
